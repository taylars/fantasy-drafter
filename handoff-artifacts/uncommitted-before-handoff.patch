+/* --- The room, simulated --------------------------------------------------
+ *
+ * `survival` above prices each player on his own, as if the picks between now
+ * and our next one were coin flips with no budget. Two things are wrong with
+ * that. Only one player comes off the board per pick, so survival across a
+ * position is strongly negatively coupled — the analytic version will happily
+ * believe we get two backs who cannot both last. And it cannot see a run: if
+ * the eleven seats ahead of us have all taken a back and none has a tight end,
+ * the tight ends are safer than their ADP says and the backs are in danger.
+ *
+ * So instead of a formula per player, play the intervening picks out. Each
+ * opposing seat is given the same generic behaviour — take near the top of the
+ * remaining board, with the ADP noise the analytic model already assumes, and
+ * nudge toward a starting slot it still owes — and the whole stretch between
+ * our picks is run a few dozen times. The share of runs in which a player is
+ * still there at one of our picks is his survival, coupling and runs included.
+ *
+ * The opponent model is deliberately dull. It reads only what a drafter in the
+ * room can read: published ADP, the league's roster slots, and the picks
+ * already made. It is not tuned against any particular opponent, and it should
+ * not be — a model fitted to the drafters in one backtest is a model of that
+ * fixture, not of a draft room.
+ */
+
+// Runs per pick. Each one costs a sort of the live board and a scan per
+// intervening pick, and the answer is a proportion, so the error on a survival
+// near a half falls as 1/sqrt(runs): 64 buys about six points of resolution,
+// which is finer than the ADP guess feeding it.
+const ROOM_RUNS = 64;
+
+// How far down the perceived board a seat will look to satisfy a need. Beyond
+// this the need nudge can no longer beat the ADP gap anyway.
+const ROOM_WINDOW = 24;
+
+// How many picks early a seat will reach for a starting slot it has not filled,
+// and how far it pushes a position it already has enough of. Both are in picks,
+// which is the unit the perceived board is in.
+const ROOM_NEED_BONUS = 12;
+const ROOM_STOCKED_PENALTY = 60;
+
+// What a seat will carry at each position before it stops wanting more. Loose
+// on purpose: this is a cap on obvious nonsense (a fourth quarterback), not a
+// roster plan.
+const ROOM_CAP = { QB: 2, RB: 6, WR: 6, TE: 2, K: 1, DEF: 1 };
+
+/* Which draft slot owns a pick number — the inverse of `ourPicks`. */
+function slotAtPick(draft, pick) {
+  const teams = draft.teams;
+  const round = Math.ceil(pick / teams);
+  const n = pick - (round - 1) * teams;
+  let forward = round % 2 === 1;
+  const reversal = draft.reversal_round ?? 0;
+  if (reversal && round >= reversal) forward = !forward;
+  if (draft.type === "linear") forward = true;
+  return forward ? n : teams - n + 1;
+}
+
+/* Starting bodies each position owes, FLEX left out — it is filled by whoever
+ * is spare and so says nothing about what a seat still needs. */
+function starterCounts(slots) {
+  const need = {};
+  for (const slot of slots) {
+    if (slot === "BN" || slot === "FLEX") continue;
+    need[slot] = (need[slot] ?? 0) + 1;
+  }
+  return need;
+}
+
+/* A small deterministic generator, so two runs of the same board agree.
+ *
+ * xorshift32 rather than the LCG used for plan paths: this one is consumed as a
+ * stream of thousands of draws where the low bits matter, which is exactly the
+ * case an LCG is bad at.
+ */
+function rng(seed) {
+  let x = (seed | 0) || 0x9e3779b9;
+  return () => {
+    x ^= x << 13; x |= 0;
+    x ^= x >>> 17;
+    x ^= x << 5; x |= 0;
+    return ((x >>> 0) + 0.5) / 4294967296;
+  };
+}
+
+/* Standard normal, Box-Muller. One log and one cos per pair of draws. */
+function normals(next) {
+  let spare = null;
+  return () => {
+    if (spare !== null) { const s = spare; spare = null; return s; }
+    const r = Math.sqrt(-2 * Math.log(next()));
+    const theta = 2 * Math.PI * next();
+    spare = r * Math.sin(theta);
+    return r * Math.cos(theta);
+  };
+}
+
+/* What every seat already holds, read off the picks already made.
+ *
+ * `gone` is the draft record in pick order, so pick k took the k-th player in
+ * it and `slotAtPick` says whose pick that was. Nothing here comes from
+ * anywhere but the draft: no seat is assumed to have a strategy, only a roster.
+ */
+function seatRosters(draft, gone, byId) {
+  const held = Array.from({ length: draft.teams + 1 }, () => ({}));
+  let pick = 0;
+  for (const id of gone) {
+    pick++;
+    const player = byId.get(id);
+    if (!player) continue;
+    const seat = slotAtPick(draft, pick);
+    held[seat][player.position] = (held[seat][player.position] ?? 0) + 1;
+  }
+  return held;
+}
+
+/* Empirical survival for every player at each of our upcoming picks.
+ *
+ * Returns `{ picks, byId }` where `byId` maps a player to the share of runs in
+ * which he was still on the board at each of `picks`, or null when the draft
+ * record is not complete enough to replay — in which case every caller falls
+ * back to the analytic `survival` above.
+ */
+function roomChances({ pool, slots, draft, gone, atPick, upcoming, ahead }) {
+  if (!draft?.teams || !upcoming.length) return null;
+  // The record has to line up with the pick we are on, or the seats we
+  // reconstruct are somebody else's.
+  if (gone.size !== atPick - 1) return null;
+
+  const picks = upcoming.slice(0, Math.max(1, ahead));
+  const horizon = picks[picks.length - 1];
+  if (horizon <= atPick) return null;
+
+  const byId = new Map(pool.map((p) => [p.player_id, p]));
+  const held = seatRosters(draft, gone, byId);
+  const need = starterCounts(slots);
+  const ourSlot = slotAtPick(draft, atPick);
+
+  // Only players who could plausibly go before the horizon are worth
+  // simulating; everyone deeper survives with probability one and is left out
+  // of the arrays entirely.
+  const span = horizon - atPick + 1;
+  const universe = [];
+  for (const player of pool) {
+    if (gone.has(player.player_id)) continue;
+    if (player.adp == null || player.adp >= 999) continue;
+    universe.push(player);
+  }
+  universe.sort((a, b) => a.adp - b.adp || a.name.localeCompare(b.name));
+  const candidates = universe.slice(0, 2 * span + 60);
+  const size = candidates.length;
+  if (!size) return null;
+
+  const adp = new Float64Array(size), sigma = new Float64Array(size);
+  const position = new Array(size);
+  for (let i = 0; i < size; i++) {
+    adp[i] = candidates[i].adp;
+    sigma[i] = Math.max(ADP_SPREAD_FLOOR, ADP_SPREAD * candidates[i].adp);
+    position[i] = candidates[i].position;
+  }
+
+  const survivors = Array.from({ length: size }, () => new Float64Array(picks.length));
+  const ourPickSet = new Set(picks);
+  const perceived = new Float64Array(size);
+  const order = new Int32Array(size);
+  const taken = new Uint8Array(size);
+  const counts = new Array(draft.teams + 1);
+
+  const next = rng(atPick * 2654435761 + gone.size * 40503 + 1);
+  const normal = normals(next);
+
+  for (let run = 0; run < ROOM_RUNS; run++) {
+    for (let i = 0; i < size; i++) {
+      perceived[i] = adp[i] + sigma[i] * normal();
+      order[i] = i;
+      taken[i] = 0;
+    }
+    order.sort((a, b) => perceived[a] - perceived[b]);
+    const sorted = order;
+    for (let seat = 1; seat <= draft.teams; seat++) counts[seat] = { ...held[seat] };
+
+    let cursor = 0, pickIndex = 0;
+    for (let pick = atPick; pick <= horizon; pick++) {
+      if (pickIndex < picks.length && picks[pickIndex] === pick) {
+        for (let k = 0; k < size; k++) if (!taken[k]) survivors[k][pickIndex]++;
+        pickIndex++;
+      }
+      // Our own picks are ours to make; the room does not make them for us.
+      if (ourPickSet.has(pick) || slotAtPick(draft, pick) === ourSlot) continue;
+
+      const seat = slotAtPick(draft, pick);
+      const seatCounts = counts[seat];
+      while (cursor < size && taken[sorted[cursor]]) cursor++;
+      let bestAt = -1, bestScore = Infinity;
+      for (let w = cursor, seen = 0; w < size && seen < ROOM_WINDOW; w++) {
+        const i = sorted[w];
+        if (taken[i]) continue;
+        seen++;
+        const pos = position[i];
+        const have = seatCounts[pos] ?? 0;
+        let score = perceived[i];
+        if (!STREAMABLE.has(pos) && have < (need[pos] ?? 0)) score -= ROOM_NEED_BONUS;
+        if (have >= (ROOM_CAP[pos] ?? 6)) score += ROOM_STOCKED_PENALTY;
+        if (score < bestScore) { bestScore = score; bestAt = i; }
+      }
+      if (bestAt < 0) break;
+      taken[bestAt] = 1;
+      seatCounts[position[bestAt]] = (seatCounts[position[bestAt]] ?? 0) + 1;
+    }
+  }
+
+  const out = new Map();
+  for (let i = 0; i < size; i++) {
+    const row = survivors[i];
+    for (let j = 0; j < picks.length; j++) row[j] /= ROOM_RUNS;
+    out.set(candidates[i].player_id, row);
+  }
+  return { picks, byId: out };
+}
+
+/* Chance this player lasts to `pick`, from the simulated room where we have
+ * one and the analytic curve where we do not. */
+function chanceAt(chances, player, pick) {
+  if (chances) {
+    const at = chances.picks.indexOf(pick);
+    if (at >= 0) {
+      const row = chances.byId.get(player.player_id);
+      // Not in the simulated universe means too deep to be at risk before the
+      // horizon, which is survival one.
+      return row ? row[at] : 1;
+    }
+  }
+  return survival(player.adp, pick);
+}
