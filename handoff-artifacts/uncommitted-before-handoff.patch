+/* --- the weekly distribution, not just its mean ---------------------------
+ *
+ * A season is not a points race: you beat one opponent a week, then win three
+ * single-elimination games. That is a function of the *distribution* of a
+ * roster's weekly score, and everything above prices only its mean.
+ *
+ * So each player also carries a weekly standard deviation, built from the same
+ * preseason fields the rest of the file uses — never from realised weeks, which
+ * would be reading the answer key. A constant coefficient of variation per
+ * position is the whole model: tight ends and defenses are famously spiky,
+ * quarterbacks are not, and a player's absolute spread scales with his mean.
+ */
+const WEEKLY_CV = { QB: 0.33, RB: 0.55, WR: 0.60, TE: 0.65, K: 0.45, DEF: 0.70 };
+const DEFAULT_CV = 0.60;
+
+// An upside grade is a wider role outcome as well as a higher mean, so it also
+// widens the week. Small: the mean correction above is the main claim.
+const UPSIDE_SPREAD = 0.06;
+
+let FLAT_CV = 0; // ablation: one coefficient of variation for every position
+
+function sigmaFor(position, weeklyMean, upside = 0) {
+  const base = FLAT_CV || (WEEKLY_CV[position] ?? DEFAULT_CV);
+  const cv = base * (1 + UPSIDE_SPREAD * Math.max(0, upside));
+  return cv * Math.max(0, weeklyMean);
+}
+
+/* One player's weekly standard deviation, memoised like `adjusted`. */
+export function weeklySigma(player) {
+  if (player._sigma === undefined) {
+    player._sigma = sigmaFor(player.position, adjusted(player) / SEASON_GAMES, player.upside);
+  }
+  return player._sigma;
+}
+
+/* How a roster's weekly spread is priced, in season points.
+ *
+ * RISK_LAMBDA is the exchange rate: season points we would pay to remove one
+ * point of weekly standard deviation. Positive prefers a floor, negative buys a
+ * ceiling, zero is the pure points model this file has always been.
+ */
+let RISK_LAMBDA = 0;
+
+// Weeks 15-17 are single elimination, where a ceiling is worth more than a
+// floor. Season points paid per point of weekly spread bought, over those
+// weeks only. Zero disables it.
+let CEILING_LAMBDA = 0;
+const PLAYOFF_WEEKS = 3;
+
+/* Experimental knobs, set by the sweep harness. */
+export function configureRisk({ risk = 0, ceiling = 0, flatCv = 0 } = {}) {
+  RISK_LAMBDA = risk;
+  CEILING_LAMBDA = ceiling;
+  FLAT_CV = flatCv;
+}
+
+/* Season value of a roster whose weeks have this mean and this variance. */
+function objective(points, variance) {
+  if (!RISK_LAMBDA && !CEILING_LAMBDA) return points;
+  const sigma = Math.sqrt(Math.max(0, variance));
+  return points - RISK_LAMBDA * SEASON_GAMES * sigma + CEILING_LAMBDA * PLAYOFF_WEEKS * sigma;
+}
