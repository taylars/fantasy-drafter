.DS_Store
node_modules/
.env

# Everything under data/ is either fetched or derived, with two exceptions:
# the researched grades, and the batches they are built from.
data/*.csv
data/*.json
!data/.gitkeep
!data/grades.json

# Sleeper responses the command-line tools keep so a rerun costs no requests.
data/cache/

# Regenerated by `node bin/grades.mjs queue`; the graded output beside them is kept.
data/grades/queue-*.json

# The old SQLite cache. Nothing reads it any more — the grades it held are in
# data/grades.json — but it is left alone rather than deleted for anyone who
# still has one on disk.
data/*.db
