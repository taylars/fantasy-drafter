.DS_Store
node_modules/
.env
.claude/worktrees

# Root-level fetched data is ignored. Canonical historical seasons are tracked.
data/*.csv
data/*.json
!data/.gitkeep

# Sleeper responses the command-line tools keep so a rerun costs no requests.
data/cache/

# The old SQLite cache. Nothing reads it any more — the grades it held are in
# data/historical/<season>/grades.json — but it is left alone rather than deleted for anyone who
# still has one on disk.
data/*.db
