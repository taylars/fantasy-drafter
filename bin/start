#!/usr/bin/env bash
#
# Serve the draft board.
#
#     bin/start                # http://localhost:8000/draft-board.html
#     bin/start --port 9000
#     bin/start --no-open      # don't open a browser
#
# The page reads data/fantasy.db in the browser, and a file:// page can't fetch
# a local file — so the board needs a server even though it's a static page.
# Everything here is about running that server from the right place with the
# right interpreter; the server itself is scripts/serve.py.

set -euo pipefail

# Paths in the loaders are relative to the repo root, so run from there no
# matter where this was called from.
cd "$(dirname "$0")/.."

# Prefer the virtualenv if there's one, so `pip install -r requirements.txt`
# into a venv is enough to make this work.
if [ -x .venv/bin/python ]; then
    python=.venv/bin/python
elif [ -x venv/bin/python ]; then
    python=venv/bin/python
else
    python=python3
fi

if ! command -v "$python" >/dev/null 2>&1 && [ ! -x "$python" ]; then
    echo "no python3 on PATH" >&2
    exit 1
fi

if [ ! -f data/fantasy.db ]; then
    echo "no data/fantasy.db yet — building the cache first"
    "$python" -m scripts.load_all
    echo
fi

exec "$python" -m scripts.serve "$@"
